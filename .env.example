# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Supabase — get these from supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Exposed to the browser via Vite (VITE_ prefix required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend — for email notifications on new comments (optional)
# If unset, comments still work but no emails are sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=OST Builder <onboarding@resend.dev>
APP_BASE_URL=https://mozost.netlify.app
