{
  "name": "ost-builder-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.16.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "npm -w @ost-builder/app run dev",
    "dev:app": "npm -w @ost-builder/shared run build && npm -w @ost-builder/app run dev",
    "build": "npm -w @ost-builder/app run build",
    "build:app": "npm -w @ost-builder/app run build",
    "build:shared": "npm -w @ost-builder/shared run build",
    "build:cli": "npm -w @ost-builder/shared run build && npm -w ost-builder run build",
    "prepublishOnly": "cp README.md packages/cli/README.md",
    "release:shared": "npm -w @ost-builder/shared run build && npm -w @ost-builder/shared run release",
    "release:cli": "npm -w @ost-builder/shared run build && npm -w ost-builder run build && npm -w ost-builder run release",
    "lint": "npm -w @ost-builder/app run lint",
    "format": "npx prettier --write \"packages/**/*.{tsx,ts,css,md,json}\" --config packages/app/.prettierrc",
    "preview": "npm -w @ost-builder/app run preview",
    "test": "npm -w @ost-builder/app run test",
    "test:watch": "npm -w @ost-builder/app run test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.2",
    "@supabase/supabase-js": "^2.50.0",
    "playwright": "^1.60.0",
    "zod": "^3.25.76"
  }
}
