{
  "name": "tree-mcp",
  "version": "0.2.2",
  "description": "MCP server for tree.prodoperationscoach.com — read-only access to your trees from any MCP client.",
  "type": "module",
  "bin": {
    "tree-mcp": "dist/index.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm --prefix ../.. -w @ost-builder/shared run build && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "release": "npm run build && npm publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ost-builder/shared": "^0.4.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "author": "Jenny Wanger",
  "keywords": [
    "ost",
    "opportunity-solution-tree",
    "mcp",
    "model-context-protocol",
    "claude",
    "product-management",
    "discovery"
  ],
  "license": "MIT",
  "homepage": "https://tree.prodoperationscoach.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennydove/ost-builder.git"
  },
  "bugs": {
    "url": "https://github.com/jennydove/ost-builder/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
